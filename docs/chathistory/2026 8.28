{"path":"C:\\Users\\Administrator\\Downloads\\diergbanben-fanout-main\\diergbanben-fanout-main\\docuverse\\src\\reasoning\\toolGateway.ts","streamContent":"  const validated = validateFormalPath({\n    blocks,\n    raw: rawForValidate,\n    premiseKeys,\n  })\n\n  const formalBlocking = input.formalBlocking === true\n  const softOk =\n    !validated.ok &&\n    !formalBlocking &&\n    Boolean((data.conclusion ?? '').trim() || (data.path ?? '').trim())\n\n  const action: ActionRecord = {\n    actionId: newActionId('infer'),\n    actionKind: 'infer',\n    premiseKeys,\n    inputsRef: {\n      question,\n      excerpt: blocks.map((b) => `${b.key}:${b.text.slice(0, 48)}`).join(' | '),\n      role: 'gateway',\n    },\n    outputsRef: validated.ok\n      ? {\n          path: validated.path.path ?? data.path,\n          conclusion: validated.path.formalConclusion,\n          roleNote: `${FANOUT_ROLE_NOTE.gateway} · infer-ops · Validator ACCEPT`,\n        }\n      : softOk\n        ? {\n            path: data.path,\n            conclusion: data.conclusion,\n            roleNote: `${FANOUT_ROLE_NOTE.gateway} · infer-ops · formal 软旁路 · ${validated.message}`,\n          }\n        : {\n            error: validated.message,\n            path: data.path,\n            conclusion: data.conclusion,\n            roleNote: `${FANOUT_ROLE_NOTE.gateway} · infer-ops · ${validated.message}`,\n          },\n    createdAt: Date.now(),\n  }\n\n  if (!validated.ok && !softOk) {\n    return {\n      action,\n      direction: null,\n      ok: false,\n      error: validated.message,\n      formalPath: validated.path,\n      formalSoftReject: false,\n    }\n  }\n\n  const fp = validated.ok\n    ? validated.path\n    : ({\n        path: data.path ?? '',\n        formalConclusion: data.conclusion ?? '',\n        ops: Array.isArray(data.ops) ? (data.ops as FormalPathV1['ops']) : [],\n        usedKeys: data.usedKeys ?? premiseKeys,\n      } as FormalPathV1)\n\n  const direction: DirectionRecord = {\n    directionId: `dir_${action.actionId}`,\n    questionText: question,\n    probe: textToProbe(question),\n    path: fp.path ?? data.path ?? '',\n    conclusion: fp.formalConclusion || data.conclusion || '',\n    createdAt: Date.now(),\n    variants: [],\n    premiseKeys,\n    actionIds: [action.actionId],\n    formalOps: [...(fp.ops ?? [])],\n    formalPath: validated.ok ? fp : undefined,\n    accepted: undefined,\n  }\n\n  return {\n    action,\n    direction,\n    ok: true,\n    formalPath: validated.ok ? fp : null,\n    formalSoftReject: softOk,\n  }\n}"}
