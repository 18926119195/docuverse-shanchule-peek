{"path":"C:\\Users\\Administrator\\Downloads\\diergbanben-fanout-main\\diergbanben-fanout-main\\docuverse\\src\\reasoning\\pipelineA.ts","streamContent":"/**\n * B-side object anchoring: BM25 over A1 atoms (no embedding).\n */\nexport async function resolveVqToCandidates(\n  index: BookIndex,\n  question: string,\n  topK = 8,\n  options?: { skipExpand?: boolean },\n): Promise<{\n  candidates: CircleCandidate[]\n  weakFigOnly: boolean\n  usedEmbedApi: boolean\n  autoLockOk: boolean\n  poolSize: number\n  expandNote: string\n  searchQuery: string\n}> {\n  const q = question.trim()\n  if (!q || index.chunks.length === 0) {\n    return {\n      candidates: [],\n      weakFigOnly: false,\n      usedEmbedApi: false,\n      autoLockOk: false,\n      poolSize: 0,\n      expandNote: '',\n      searchQuery: q,\n    }\n  }\n\n  const expanded = options?.skipExpand\n    ? {\n        original: q,\n        searchQuery: q,\n        terms: [],\n        usedApi: false,\n        skipped: true,\n        note: 'skipExpand',\n      }\n    : await expandQueryForRetrieval(q)\n  const retrievalQ = expanded.searchQuery\n\n  const bm = await recallCandidatesByBm25({\n    bookIndex: index,\n    query: retrievalQ,\n    topK,\n    allowedKeys: null,\n  })\n\n  return {\n    candidates: bm.candidates,\n    weakFigOnly: bm.weakFigOnly,\n    usedEmbedApi: false,\n    autoLockOk: bm.autoLockOk,\n    poolSize: bm.poolSize,\n    expandNote: expanded.note,\n    searchQuery: retrievalQ,\n  }\n}"}
