{"path":"C:\\Users\\Administrator\\Downloads\\diergbanben-fanout-main\\diergbanben-fanout-main\\docuverse\\src\\reasoning\\retrieveFunnel.ts","streamContent":"/**\n * Retrieve funnel — directory shrink → in-domain recall → draftKeys.\n * Whole-book vector is upgrade / gap path only (handbook §0.6 / checklist P1).\n */\n\nimport type { BookIndex, CircleCandidate } from './pipelineA'\nimport { resolveVqToCandidates } from './pipelineA'\nimport type { BookSemanticIndex } from './semanticIndex'\nimport {\n  keysInSections,\n  rankSections,\n  sectionHitNote,\n} from './semanticIndex'\nimport { FANOUT_ROLE_NOTE } from './fanoutRoles'\nimport type { ActionRecord } from './types'\n\nfunction newActionId(kind: string): string {\n  return `${kind}_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 8)}`\n}\n\nexport type FunnelStage =\n  | 'directory_shrink'\n  | 'in_domain'\n  | 'whole_book_upgrade'\n  | 'fallback_whole_book'\n\nexport interface RetrieveFunnelResult {\n  action: ActionRecord\n  candidates: CircleCandidate[]\n  searchQuery: string\n  poolSize: number\n  autoLockOk: boolean\n  expandNote: string\n  stage: FunnelStage\n  sectionIds: string[]\n  draftKeys: string[]\n  lockCorridorHint?: string\n}\n\nexport async function runRetrieveFunnel(input: {\n  bookIndex: BookIndex\n  question: string\n  topK?: number\n  semanticIndex?: BookSemanticIndex | null\n  /** Force whole-book vector (gap / user upgrade) */\n  forceWholeBook?: boolean\n  /** Prefer these corridor nodeIds as shrink set */\n  preferredSectionIds?: ReadonlyArray<string>\n}): Promise<RetrieveFunnelResult> {\n  const question = input.question.trim()\n  const topK = input.topK ?? 5\n  const semantic = input.semanticIndex ?? null\n\n  const resolved = await resolveVqToCandidates(input.bookIndex, question, topK * 2)\n  let candidates = resolved.candidates\n  let expandNote = resolved.expandNote\n  let stage: FunnelStage = 'fallback_whole_book'\n  let sectionIds: string[] = []\n  let lockCorridorHint: string | undefined\n\n  if (input.forceWholeBook) {\n    stage = 'whole_book_upgrade'\n    expandNote = [expandNote, '升档·全书向量'].filter(Boolean).join(' · ')\n  } else if (semantic && semantic.sections.length > 0) {\n    const preferred = input.preferredSectionIds?.filter(Boolean) ?? []\n    const sectionHits =\n      preferred.length > 0\n        ? preferred\n            .map((id) => semantic.sections.find((s) => s.nodeId === id))\n            .filter(Boolean)\n            .map((node) => ({ node: node!, score: 1 }))\n        : rankSections(semantic, question, 4)\n\n    if (sectionHits.length > 0) {\n      sectionIds = sectionHits.map((h) => h.node.nodeId)\n      lockCorridorHint = sectionIds[0]\n      const allowed = keysInSections(semantic, new Set(sectionIds))\n      const filtered = candidates.filter((c) => allowed.has(c.R.key))\n\n      if (filtered.length > 0) {\n        candidates = filtered.slice(0, topK)\n        stage = preferred.length > 0 ? 'directory_shrink' : 'in_domain'\n        expandNote = [\n          expandNote,\n          stage === 'directory_shrink' ? '目录锁廊缩域' : '域内召回',\n          `节级: ${sectionHitNote(sectionHits)}`,\n        ]\n          .filter(Boolean)\n          .join(' · ')\n      } else {\n        // Domain empty → soft upgrade note, keep whole-book hits\n        stage = 'whole_book_upgrade'\n        candidates = resolved.candidates.slice(0, topK)\n        expandNote = [\n          expandNote,\n          '域内空·升档全书',\n          `节级曾命中: ${sectionHitNote(sectionHits)}`,\n        ]\n          .filter(Boolean)\n          .join(' · ')\n      }\n    } else {\n      candidates = resolved.candidates.slice(0, topK)\n      stage = 'fallback_whole_book'\n      expandNote = [expandNote, '无节命中·全书兜底']\n        .filter(Boolean)\n        .join(' · ')\n    }\n  } else {\n    candidates = resolved.candidates.slice(0, topK)\n  }\n\n  const draftKeys = candidates.map((c) => c.R.key)\n  const action: ActionRecord = {\n    actionId: newActionId('retrieve'),\n    actionKind: 'retrieve',\n    premiseKeys: [],\n    inputsRef: {\n      question,\n      role: 'draft',\n      funnelStage: stage,\n      sectionIds,\n    },\n    outputsRef: {\n      candidateKeys: draftKeys,\n      draftKeys,\n      roleNote: [\n        FANOUT_ROLE_NOTE.draft,\n        `漏斗=${stage}`,\n        expandNote || '',\n      ]\n        .filter(Boolean)\n        .join(' · '),\n    },\n    createdAt: Date.now(),\n  }\n\n  return {\n    action,\n    candidates,\n    searchQuery: resolved.searchQuery,\n    poolSize: resolved.poolSize,\n    autoLockOk: resolved.autoLockOk,\n    expandNote,\n    stage,\n    sectionIds,\n    draftKeys,\n    lockCorridorHint,\n  }\n}\n"}
