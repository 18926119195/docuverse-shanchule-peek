{"path":"C:\\Users\\Administrator\\Downloads\\diergbanben-fanout-main\\diergbanben-fanout-main\\docuverse\\src\\reasoning\\indexGate.ts","streamContent":"/**\n * Post-upload gate: OCR → A1 build → V_book embed → ready for V_q questions.\n * TOC wizard: calibrate printed↔strand → confirm chapters (skippable with warning).\n */\n\nimport { create } from 'zustand'\nimport { saveBookIndex } from './bookIndexStore'\nimport {\n  buildBookIndex,\n  patchAtomTextInBookIndex,\n  rebuildPagesInBookIndex,\n  reembedBookIndex,\n  type BookIndex,\n} from './pipelineA'\nimport {\n  buildSemanticFromTocEntries,\n  buildSemanticIndex,\n  semanticTocReady,\n  type BookSemanticIndex,\n} from './semanticIndex'\nimport { saveSemanticIndex } from './semanticIndexStore'\nimport type { OcrPageResult } from '../data/ocrService'\nimport type { PageDocument } from '../zigzag/types'\nimport type { PageCalibration } from './pageCalibration'\nimport type { TocEntryDraft } from './tocParse'\n\nexport type IndexPhase =\n  | 'idle'\n  | 'importing'\n  | 'ocr'\n  | 'embedding'\n  | 'ready'\n  | 'error'\n\nexport type TocWizardStatus = 'idle' | 'pending' | 'confirmed' | 'skipped'\n\ninterface IndexGateState {\n  phase: IndexPhase\n  message: string\n  ready: boolean\n  bookIndex: BookIndex | null\n  semanticIndex: BookSemanticIndex | null\n  lastError: string | null\n  /** TOC wizard lifecycle */\n  tocStatus: TocWizardStatus\n  tocWizardOpen: boolean\n  pageCalibration: PageCalibration | null\n\n  reset: () => void\n  setImporting: (msg?: string) => void\n  finalizeIndex: (input: {\n    docId: string\n    pages: PageDocument[]\n    ocrByStrand: Record<number, OcrPageResult>\n  }) => Promise<BookIndex>\n  syncPages: (input: {\n    docId: string\n    pages: PageDocument[]\n    ocrByStrand: Record<number, OcrPageResult>\n    pageIndices: number[]\n  }) => Promise<BookIndex>\n  syncAtomText: (input: {\n    atomKey: string\n    content: string\n  }) => Promise<BookIndex | null>\n  setError: (msg: string) => void\n  setBookIndex: (index: BookIndex, ready?: boolean) => void\n\n  openTocWizard: () => void\n  closeTocWizard: () => void\n  setPageCalibration: (cal: PageCalibration | null) => void\n  /** Apply TOC entries → replace semantic sections; keep ready */\n  confirmTocWizard: (entries: TocEntryDraft[]) => {\n    ok: boolean\n    error?: string\n  }\n  /** Skip formal TOC; keep heuristic one-page sections + warning */\n  skipTocWizard: () => void\n}\n\nexport const useIndexGate = create<IndexGateState>((set, get) => ({\n  phase: 'idle',\n  message: '尚未导入文献',\n  ready: false,\n  bookIndex: null,\n  semanticIndex: null,\n  lastError: null,\n  tocStatus: 'idle',\n  tocWizardOpen: false,\n  pageCalibration: null,\n\n  reset: () =>\n    set({\n      phase: 'idle',\n      message: '尚未导入文献',\n      ready: false,\n      bookIndex: null,\n      semanticIndex: null,\n      lastError: null,\n      tocStatus: 'idle',\n      tocWizardOpen: false,\n      pageCalibration: null,\n    }),\n\n  setImporting: (msg) =>\n    set({\n      phase: 'importing',\n      message: msg ?? '正在导入…',\n      ready: false,\n      lastError: null,\n      tocStatus: 'idle',\n      tocWizardOpen: false,\n      pageCalibration: null,\n    }),\n\n  setError: (msg) =>\n    set({\n      phase: 'error',\n      message: msg,\n      ready: false,\n      lastError: msg,\n    }),\n\n  setBookIndex: (index, ready = true) => {\n    saveBookIndex(index)\n    const semantic = buildSemanticIndex(index)\n    saveSemanticIndex(semantic)\n    const tocOk = semanticTocReady(semantic)\n    set({\n      bookIndex: index,\n      semanticIndex: semantic,\n      ready: ready && tocOk,\n      phase: ready && tocOk ? 'ready' : ready ? 'embedding' : 'embedding',\n      message:\n        ready && tocOk\n          ? `文献就绪 · ${index.chunks.length} 段 · ${semantic.sections.length} 节（启发式目录·请确认或跳过）`\n          : ready\n            ? '文献已建库，目录归 key 未完成'\n            : '文献整理中…',\n      lastError: null,\n      tocStatus: ready && tocOk ? 'pending' : get().tocStatus,\n      tocWizardOpen: ready && tocOk,\n    })\n  },\n\n  finalizeIndex: async (input) => {\n    set({\n      phase: 'embedding',\n      message: '正在整理文献…',\n      ready: false,\n      lastError: null,\n    })\n    try {\n      const raw = await buildBookIndex(input)\n      const { index } = await reembedBookIndex(raw)\n      saveBookIndex(index)\n      const semantic = buildSemanticIndex(index)\n      saveSemanticIndex(semantic)\n      const tocOk = semanticTocReady(semantic)\n      set({\n        bookIndex: index,\n        semanticIndex: semantic,\n        ready: tocOk,\n        phase: tocOk ? 'ready' : 'embedding',\n        message: tocOk\n          ? `文献就绪 · ${index.chunks.length} 段 · ${semantic.sections.length} 节（启发式目录·请确认 TOC 或跳过）`\n          : `建库完成但目录未就绪 · ${index.chunks.length} 段`,\n        lastError: null,\n        tocStatus: tocOk ? 'pending' : 'idle',\n        tocWizardOpen: tocOk,\n        pageCalibration: null,\n      })\n      return index\n    } catch (e) {\n      const msg = e instanceof Error ? e.message : String(e)\n      set({\n        phase: 'error',\n        message: msg,\n        ready: false,\n        lastError: msg,\n      })\n      throw e\n    }\n  },\n\n  syncPages: async (input) => {\n    const pagesLabel = [...input.pageIndices]\n      .sort((a, b) => a - b)\n      .map((p) => `s${p}`)\n      .join(',')\n    const prevReady = get().ready\n    const prevToc = get().tocStatus\n    set({\n      phase: 'embedding',\n      message: `正在同步索引（${pagesLabel || '页'}）…`,\n      lastError: null,\n    })\n    try {\n      const existing =\n        get().bookIndex && get().bookIndex!.docId === input.docId\n          ? get().bookIndex\n          : null\n      const { index } = await rebuildPagesInBookIndex({\n        existing,\n        docId: input.docId,\n        pages: input.pages,\n        ocrByStrand: input.ocrByStrand,\n        pageIndices: input.pageIndices,\n      })\n      saveBookIndex(index)\n      // Keep confirmed TOC if any; else rebuild heuristic\n      let semantic = get().semanticIndex\n      if (!semantic || !semantic.tocConfirmed || semantic.docId !== index.docId) {\n        semantic = buildSemanticIndex(index)\n      }\n      saveSemanticIndex(semantic)\n      const tocOk = semanticTocReady(semantic)\n      set({\n        bookIndex: index,\n        semanticIndex: semantic,\n        ready: tocOk,\n        phase: tocOk ? 'ready' : 'embedding',\n        message: tocOk\n          ? `文献就绪 · ${index.chunks.length} 段 · ${semantic.sections.length} 节（已同步 ${pagesLabel}）`\n          : `同步完成但目录未就绪 · ${pagesLabel}`,\n        lastError: null,\n        tocStatus: prevToc === 'confirmed' ? 'confirmed' : prevToc,\n      })\n      return index\n    } catch (e) {\n      const msg = e instanceof Error ? e.message : String(e)\n      set({\n        phase: prevReady ? 'ready' : 'error',\n        ready: prevReady,\n        message: prevReady\n          ? `${get().bookIndex ? `文献就绪 · ${get().bookIndex!.chunks.length} 段可检索` : get().message} · 同步失败: ${msg}`\n          : msg,\n        lastError: msg,\n      })\n      throw e\n    }\n  },\n\n  syncAtomText: async (input) => {\n    const existing = get().bookIndex\n    if (!existing) return null\n    try {\n      const { index, patched } = await patchAtomTextInBookIndex(\n        existing,\n        input.atomKey,\n        input.content,\n      )\n      if (!patched) return existing\n      saveBookIndex(index)\n      const prev = get().semanticIndex\n      const semantic =\n        prev?.tocConfirmed && prev.docId === index.docId\n          ? prev\n          : buildSemanticIndex(index)\n      saveSemanticIndex(semantic)\n      set({\n        bookIndex: index,\n        semanticIndex: semantic,\n        ready: true,\n        phase: 'ready',\n        message: `文献就绪 · ${index.chunks.length} 段 · ${semantic.sections.length} 节（已更新 T）`,\n        lastError: null,\n      })\n      return index\n    } catch (e) {\n      const msg = e instanceof Error ? e.message : String(e)\n      set({ lastError: msg })\n      throw e\n    }\n  },\n\n  openTocWizard: () => set({ tocWizardOpen: true }),\n  closeTocWizard: () => set({ tocWizardOpen: false }),\n  setPageCalibration: (cal) => set({ pageCalibration: cal }),\n\n  confirmTocWizard: (entries) => {\n    const bookIndex = get().bookIndex\n    const cal = get().pageCalibration\n    if (!bookIndex) return { ok: false, error: '尚无 A1 索引' }\n    if (!cal) return { ok: false, error: '请先完成页码校准' }\n    if (entries.length === 0) return { ok: false, error: '目录条目为空' }\n\n    const semantic = buildSemanticFromTocEntries({\n      bookIndex,\n      entries,\n      calibration: cal,\n    })\n    const empty = semantic.sections.filter(\n      (s) => (s.memberKeys?.length ?? 0) === 0,\n    )\n    if (empty.length === semantic.sections.length) {\n      return {\n        ok: false,\n        error: '所有章节 key 数为 0：请检查校准或印码范围是否超出已导入页',\n      }\n    }\n    saveSemanticIndex(semantic)\n    set({\n      semanticIndex: semantic,\n      tocStatus: 'confirmed',\n      tocWizardOpen: false,\n      ready: true,\n      phase: 'ready',\n      message: `目录已确认 · ${semantic.sections.length} 章 · ${bookIndex.chunks.length} 段可检索`,\n      lastError: null,\n    })\n    return { ok: true }\n  },\n\n  skipTocWizard: () => {\n    const semantic = get().semanticIndex\n    const bookIndex = get().bookIndex\n    if (semantic) {\n      const next: BookSemanticIndex = {\n        ...semantic,\n        tocConfirmed: false,\n        tocSkipped: true,\n      }\n      saveSemanticIndex(next)\n      set({\n        semanticIndex: next,\n        tocStatus: 'skipped',\n        tocWizardOpen: false,\n        ready: Boolean(bookIndex && semanticTocReady(next)),\n        phase: 'ready',\n        message: bookIndex\n          ? `已跳过目录确认 · 仍用启发式一页一节 · ${bookIndex.chunks.length} 段可提问（缩域可能不准）`\n          : get().message,\n      })\n    } else {\n      set({ tocStatus: 'skipped', tocWizardOpen: false })\n    }\n  },\n}))\n"}
