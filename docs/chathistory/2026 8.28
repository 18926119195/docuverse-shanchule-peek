g-top: 10px;\n  border-top: 1px solid rgba(255, 255, 255, 0.06);\n}\n\n.toc-skip-banner {\n  margin: 0 0 10px;\n  padding: 8px 10px;\n  border: 1px solid rgba(255, 138, 138, 0.45);\n  background: rgba(80, 20, 20, 0.35);\n  border-radius: 8px;\n  font-size: 12px;\n  line-height: 1.45;\n  color: #ffc9c9;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  align-items: center;\n}\n\n.toc-skip-banner .fanout-btn {\n  margin-left: auto;\n}"}
