{"path":"C:\\Users\\Administrator\\Downloads\\diergbanben-fanout-main\\diergbanben-fanout-main\\docuverse\\src\\reasoning\\semanticIndex.ts","streamContent":"  return {\n    ...index,\n    sections,\n    provenance,\n    tocConfirmed: true,\n    tocSkipped: false,\n    builtAt: Date.now(),\n  }\n}\n\n/**\n * Replace heuristic sections with TOC chapters:\n * printed ranges → strand ranges via calibration → memberKeys from A1.\n */\nexport function buildSemanticFromTocEntries(input: {\n  bookIndex: BookIndex\n  entries: ReadonlyArray<TocEntryDraft>\n  calibration: PageCalibration\n  /** Max printed page for last chapter end fill */\n  lastPrintedFallback?: number\n}): BookSemanticIndex {\n  const { bookIndex, calibration } = input\n  const maxStrand = Math.max(0, ...bookIndex.chunks.map((c) => c.page))\n  const lastPrinted =\n    input.lastPrintedFallback ??\n    maxStrand - calibration.offset\n\n  const entries = fillEndPrinted([...input.entries], lastPrinted)\n  const byPage = new Map<number, string[]>()\n  for (const c of bookIndex.chunks) {\n    const list = byPage.get(c.page) ?? []\n    list.push(c.key)\n    byPage.set(c.page, list)\n  }\n\n  const sections: SectionNode[] = []\n  const provenance: SlotProvenance[] = []\n  const claimed = new Set<string>()\n\n  for (let i = 0; i < entries.length; i++) {\n    const e = entries[i]\n    const range = printedRangeToStrandRange(\n      e.startPrinted,\n      e.endPrinted,\n      calibration,\n    )\n    const startPage = Math.max(0, range.startPage)\n    const endPage = Math.min(maxStrand, range.endPage)\n    const memberKeys: string[] = []\n    for (let p = startPage; p <= endPage; p++) {\n      for (const k of byPage.get(p) ?? []) {\n        if (!claimed.has(k)) {\n          memberKeys.push(k)\n          claimed.add(k)\n        }\n      }\n    }\n    const nodeId = `sec_${bookIndex.docId}_toc_${i}`\n    const summary = `印码 ${e.startPrinted}–${e.endPrinted} · 机器牌 ${startPage + 1}–${endPage + 1} · ${memberKeys.length} keys`\n    sections.push({\n      nodeId,\n      docId: bookIndex.docId,\n      page: startPage,\n      pageRange: { startPage, endPage },\n      memberKeys,\n      title: e.title,\n      summary,\n      source: 'heuristic',\n      probe: textToProbe(`${e.title} ${summary}`),\n      ord: i,\n    })\n    for (const k of memberKeys) {\n      provenance.push({\n        key: k,\n        primaryNodeId: nodeId,\n        role: 'body',\n      })\n    }\n  }\n\n  return {\n    docId: bookIndex.docId,\n    sections,\n    provenance,\n    builtAt: Date.now(),\n    tocConfirmed: true,\n    tocSkipped: false,\n    pageCalibration: calibration,\n  }\n}\n\nexport function sectionHitNote("}
