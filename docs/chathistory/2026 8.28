{"path":"C:\\Users\\Administrator\\Downloads\\diergbanben-fanout-main\\diergbanben-fanout-main\\docuverse\\src\\reasoning\\instructionCompose.ts","streamContent":"/**\n * Instruction compose — primary bag builder (handbook: geometric out of main path).\n * Hard gate: every memberKey ⊆ draftKeys ∪ scopedKeys.\n */\n\nimport type { BookIndex, CircleCandidate, AChunk } from './pipelineA'\nimport { atomToCandidate } from './pipelineA'\nimport type { FanoutInferUnit } from './fanoutCompose'\nimport { composeFanoutUnits } from './fanoutCompose'\nimport {\n  defaultComposePolicy,\n  type ComposePolicy,\n} from './composePolicy'\nimport { gateBagSubset } from './hardGates'\nimport { FANOUT_ROLE_NOTE } from './fanoutRoles'\nimport type { ActionRecord } from './types'\n\nfunction newActionId(kind: string): string {\n  return `${kind}_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 8)}`\n}\n\nexport type InstructionBagMode =\n  | 'fine_only'\n  | 'top_singles'\n  | 'pair_adjacent'\n  | 'custom'\n\nexport interface InstructionComposeSpec {\n  mode?: InstructionBagMode\n  /** Max bags (default 5) */\n  maxBags?: number\n  /** Explicit bags from human / LLM (each ⊆ allow set) */\n  customBags?: ReadonlyArray<ReadonlyArray<string>>\n  /** Allow geometric fallback when instruction bags empty */\n  allowGeometricFallback?: boolean\n  geometricPolicy?: ComposePolicy\n}\n\nfunction chunkByKey(index: BookIndex, key: string): AChunk | undefined {\n  return index.chunks.find((c) => c.key === key)\n}\n\nfunction adjacentPairs(\n  hits: Array<AChunk & { score: number }>,\n): Array<[AChunk & { score: number }, AChunk & { score: number }]> {\n  const sorted = [...hits].sort((a, b) => a.ord - b.ord)\n  const pairs: Array<[AChunk & { score: number }, AChunk & { score: number }]> =\n    []\n  for (let i = 0; i < sorted.length - 1; i++) {\n    const a = sorted[i]\n    const b = sorted[i + 1]\n    if (a.page === b.page && b.ord === a.ord + 1) pairs.push([a, b])\n  }\n  return pairs\n}\n\nasync function unitFromRun(\n  bookIndex: BookIndex,\n  run: Array<AChunk & { score: number }>,\n  label: string,\n  kind: FanoutInferUnit['kind'],\n): Promise<FanoutInferUnit | null> {\n  if (run.length === 0) return null\n  const candidate = await atomToCandidate(\n    bookIndex.docId,\n    run,\n    `instr_${kind}`,\n  )\n  return { kind, label, candidate }\n}\n\n/**\n * Build instruction bags; drops any bag that fails G1.\n */\nexport async function composeInstructionBags(\n  bookIndex: BookIndex,\n  fineCandidates: CircleCandidate[],\n  draftKeys: ReadonlyArray<string>,\n  scopedKeys: ReadonlyArray<string> = [],\n  spec: InstructionComposeSpec = {},\n): Promise<FanoutInferUnit[]> {\n  const maxBags = spec.maxBags ?? 5\n  const mode = spec.mode ?? 'top_singles'\n  const allow = new Set([...draftKeys, ...scopedKeys])\n  const units: FanoutInferUnit[] = []\n\n  const pushIfOk = async (u: FanoutInferUnit | null) => {\n    if (!u || units.length >= maxBags) return\n    const members = u.candidate.R.memberKeys?.length\n      ? u.candidate.R.memberKeys\n      : [u.candidate.R.key]\n    const g = gateBagSubset(members, draftKeys, scopedKeys)\n    if (!g.ok) return\n    units.push(u)\n  }\n\n  if (mode === 'custom' && spec.customBags?.length) {\n    for (const bag of spec.customBags) {\n      const run = bag\n        .map((k) => {\n          const c = chunkByKey(bookIndex, k)\n          return c && allow.has(k) ? { ...c, score: 1 } : null\n        })\n        .filter((c): c is AChunk & { score: number } => Boolean(c))\n      if (run.length === 0) continue\n      await pushIfOk(\n        await unitFromRun(\n          bookIndex,\n          run,\n          run.length === 1\n            ? `单门 ${run[0].key.slice(-8)}`\n            : `指令袋×${run.length}`,\n          run.length === 1 ? 'fine' : 'cluster',\n        ),\n      )\n    }\n    return units\n  }\n\n  const scored = fineCandidates\n    .map((c) => {\n      const chunk = chunkByKey(bookIndex, c.R.key)\n      if (!chunk || !allow.has(c.R.key)) return null\n      return { ...chunk, score: c.score }\n    })\n    .filter((c): c is AChunk & { score: number } => Boolean(c))\n    .sort((a, b) => b.score - a.score)\n\n  if (mode === 'fine_only' || mode === 'top_singles') {\n    for (const c of scored.slice(0, maxBags)) {\n      await pushIfOk(\n        await unitFromRun(\n          bookIndex,\n          [c],\n          `门 ${c.key.slice(-10)}`,\n          'fine',\n        ),\n      )\n    }\n  }\n\n  if (mode === 'pair_adjacent') {\n    for (const [a, b] of adjacentPairs(scored).slice(0, maxBags)) {\n      await pushIfOk(\n        await unitFromRun(\n          bookIndex,\n          [a, b],\n          `邻袋 p${a.page + 1}`,\n          'cluster',\n        ),\n      )\n    }\n    for (const c of scored) {\n      if (units.length >= maxBags) break\n      await pushIfOk(\n        await unitFromRun(bookIndex, [c], `门 ${c.key.slice(-10)}`, 'fine'),\n      )\n    }\n  }\n\n  return units\n}\n\nexport async function executeInstructionCompose(input: {\n  bookIndex: BookIndex\n  fineCandidates: CircleCandidate[]\n  draftKeys: ReadonlyArray<string>\n  scopedKeys?: ReadonlyArray<string>\n  question?: string\n  spec?: InstructionComposeSpec\n}): Promise<{\n  action: ActionRecord\n  units: FanoutInferUnit[]\n  ok: boolean\n  error?: string\n  usedGeometricFallback: boolean\n}> {\n  const scoped = input.scopedKeys ?? []\n  const draftKeys =\n    input.draftKeys.length > 0\n      ? input.draftKeys\n      : input.fineCandidates.map((c) => c.R.key)\n\n  let units = await composeInstructionBags(\n    input.bookIndex,\n    input.fineCandidates,\n    draftKeys,\n    scoped,\n    input.spec,\n  )\n  let usedGeometricFallback = false\n\n  if (units.length === 0 && input.spec?.allowGeometricFallback !== false) {\n    const policy: ComposePolicy = {\n      ...defaultComposePolicy(),\n      includeFine: true,\n      includeWindow: false,\n      includeSamePageCluster: false,\n      includeCrossPage: false,\n      ...input.spec?.geometricPolicy,\n    }\n    const geo = await composeFanoutUnits(\n      input.bookIndex,\n      input.fineCandidates,\n      policy,\n    )\n    units = geo.filter((u) => {\n      const members = u.candidate.R.memberKeys?.length\n        ? u.candidate.R.memberKeys\n        : [u.candidate.R.key]\n      return gateBagSubset(members, draftKeys, scoped).ok\n    })\n    usedGeometricFallback = units.length > 0\n  }\n\n  const allMembers = [\n    ...new Set(\n      units.flatMap((u) =>\n        u.candidate.R.memberKeys?.length\n          ? u.candidate.R.memberKeys\n          : [u.candidate.R.key],\n      ),\n    ),\n  ]\n\n  const action: ActionRecord = {\n    actionId: newActionId('compose'),\n    actionKind: 'compose',\n    premiseKeys: allMembers,\n    inputsRef: {\n      question: input.question,\n      sourceKeys: draftKeys,\n      role: 'letter',\n      composeMode: input.spec?.mode ?? 'top_singles',\n      usedGeometricFallback,\n    },\n    outputsRef: {\n      units: units.map((u) => {\n        const memberKeys =\n          u.candidate.R.memberKeys?.length\n            ? u.candidate.R.memberKeys\n            : [u.candidate.R.key]\n        return {\n          kind: u.kind,\n          label: u.label,\n          unitKey: u.candidate.R.key,\n          memberKeys,\n        }\n      }),\n      candidateKeys: units.map((u) => u.candidate.R.key),\n      roleNote: `${FANOUT_ROLE_NOTE.letter} · 指令组袋${\n        usedGeometricFallback ? ' · 几何兜底' : ''\n      }`,\n    },\n    createdAt: Date.now(),\n  }\n\n  if (units.length === 0) {\n    return {\n      action,\n      units: [],\n      ok: false,\n      error: '指令组袋为空（且无可用几何兜底）',\n      usedGeometricFallback,\n    }\n  }\n\n  return { action, units, ok: true, usedGeometricFallback }\n}\n"}
