{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/protocol/emit-page.ts": {
      "maxDuration": 60
    },
    "api/llm/chat/completions.ts": {
      "maxDuration": 60
    },
    "api/llm/embeddings.ts": {
      "maxDuration": 60
    },
    "api/zhipu/chat/completions.ts": {
      "maxDuration": 60
    },
    "api/zhipu/layout_parsing.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
