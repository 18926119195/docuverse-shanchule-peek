# Copy to `.env` / `.env.local` for local defaults.
# Secrets: never commit. On Vercel → Project → Settings → Environment Variables.
# Note: api/_lib/env.ts also bakes locked demo fallbacks for OCR + DeepSeek-V4-Pro.

# ── 服务端密钥（推荐 · 浏览器不可见）────────────────────────────────
ZHIPU_API_KEY=
# 硅基流动等 OpenAI 兼容上游（chat + embeddings）
LLM_API_KEY=
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# 推理模型在服务端锁定为 DeepSeek-V4-Pro（浏览器无法改）
# EMBED_MODEL=Qwen/Qwen3-VL-Embedding-8B

# 公开 demo 门禁（两端一致；空=开发期不加锁）
DEMO_ACCESS_TOKEN=
VITE_DEMO_ACCESS_TOKEN=

# 密封句柄密钥（强烈建议生产单独设置；缺省回退 DEMO_ACCESS_TOKEN）
HANDLE_SECRET=

# ── 浏览器只配代理路径 / 展示名（勿再填上游 Key）────────────────────
VITE_OCR_BASE_URL=/api/zhipu
VITE_OCR_MODEL=glm-ocr
VITE_LLM_BASE_URL=/api/llm
VITE_LLM_MODEL=deepseek-v4-flash
VITE_EMBED_BASE_URL=/api/llm
VITE_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-8B

# 外显演示：隐藏 Pilot 部署面板等
VITE_PUBLIC_DEMO=true

# ── 不推荐：会打进前端包 ───────────────────────────────────────────
# VITE_OCR_API_KEY=
# VITE_LLM_API_KEY=
# VITE_EMBED_API_KEY=
